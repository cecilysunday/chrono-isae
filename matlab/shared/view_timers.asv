% -------------------------------------------------------------------------
% FUNCTION  view_timers             Import the system_stats file and display
%                                   the partitioning of computation time
% INPUTS    dpath                   Data file path (contains system_energy.txt)
%           rpath (optional)        Filepath to results folder. If given, the
%                                   figure is saved there as a PNG
% OUTPUTS   F                       Figure handle
% -------------------------------------------------------------------------
function [F] = view_timers(dpath,rpath)

% Load the system stats file
fname = fullfile(dpath,'system_stats.txt');
if ~isfile(fname)
    warning('Unable to plot simulation timers. The system_stats.txt file does not exist in the specified directory. \n');
    F = [];
    return;
end

% Import the stats file as a table of doubles
opts = detectImportOptions(fname, 'Delimiter', ' ', 'CommentStyle', '#', 'ReadRowNames', true, 'ReadVariableNames', false);
opts = setvaropts(opts, 'Var2', 'Type', 'double');
opts.DataLines = [2 Inf];

S = readtable(fname, opts);
S = rows2vars(S);
S = S(:,2:end);

% Define timers
timers = [S.timer_broad_collision S.timer_narrow_collision S.timer_custom_collision S.timer_other_collision ... 
          S.timer_total_update S.timer_total_advance S.timer_total_other];
labels = {'collision-broad ('; 'collision-narrow ('; 'collision-custom ('; 'collision-other ('; 'update ('; 'advance ('; 'other ('};
remove = find(timers == 0);
timers(remove) = [];
labels(remove) = [];

% Plot simulation timers as pie chart
figure('name', 'system_stats')
set(gcf, 'Position',  [100, 100, 600, 400])
p = pie(timers);
ptext = findobj(p, 'Type', 'text');
pvalues = get(ptext, 'String'); 
combinedtxt = strcat(labels, pvalues, ')'); 
for i = 1:length(ptext)
    ptext(i).String = combinedtxt(i);
end
set(gcf, 'Color', 'w');
title('Computation Time by Function Type');
box('on');

txt1 = strcat('Number of bodies =', " ", num2str(S.num_shapes, 4));
txt2 = strcat('CPU time =', " ", num2str(S.sim_cpu, 4), " ", 'sec per time-step per body');
text(0, min(ylim)-0.10, txt1, 'VerticalAlignment', 'middle', 'HorizontalAlignment', 'center');
text(0, min(ylim)-0.22, txt2, 'VerticalAlignment', 'middle', 'HorizontalAlignment', 'center');

% Save plot
if nargin > 1 && ~isempty(rpath)
    if ~isfolder(rpath)
        mkdir(rpath); 
    end
    exportgraphics(F, fullfile(rpath,'timers.png'), 'Resolution', 300, 'Padding', 'figure');
end

end

